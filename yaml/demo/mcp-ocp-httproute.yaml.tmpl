apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ocp-mcp-server-route
  namespace: demo
  labels:
    mcp-server: 'true'
spec:
  hostnames:
    - mcp.${CLUSTER_DOMAIN}
  parentRefs:
    - name: mcp-default-gateway
      namespace: openshift-ingress
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: ocp-mcp-server
          port: 8080